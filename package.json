{
  "name": "sajjad-design-dna",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent skill and CLI design-system audit and export tools",
  "scripts": {
    "test": "node --test scripts/test/*.test.mjs",
    "audit": "node scripts/audit.mjs examples/sample-dna.json",
